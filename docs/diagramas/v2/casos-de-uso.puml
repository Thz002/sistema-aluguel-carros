@startuml casos-de-uso
title Sistema de Aluguel de Carros - Diagrama de Casos de Uso (v2)
left to right direction
skinparam actorStyle awesome

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

rectangle "Sistema de Aluguel de Carros" {
  usecase "UC01 - Cadastrar-se" as UC01
  usecase "UC02 - Autenticar (login)" as UC02
  usecase "UC03 - Manter dados do cliente" as UC03
  usecase "UC04 - Introduzir pedido" as UC04
  usecase "UC05 - Modificar pedido" as UC05
  usecase "UC06 - Consultar pedido" as UC06
  usecase "UC07 - Cancelar pedido" as UC07
  usecase "UC08 - Avaliar pedido (análise financeira)" as UC08
  usecase "UC09 - Executar contrato" as UC09
  usecase "UC10 - Conceder contrato de crédito" as UC10
  usecase "UC11 - Manter automóveis" as UC11
  usecase "UC12 - Manter clientes (CRUD)" as UC12
}

Usuario --> UC02
Cliente --> UC01
Cliente --> UC03
Cliente --> UC04
Cliente --> UC05
Cliente --> UC06
Cliente --> UC07

Agente --> UC05
Agente --> UC06
Agente --> UC08
Agente --> UC09
Agente --> UC11
Agente --> UC12
Banco --> UC10

UC09 <.. UC10 : <<extend>>
UC02 <.. UC01 : <<extend>>\n(sem conta: "Cadastre-se")
note bottom of UC02 : "Lembrar de mim": sessão no localStorage;\nsem a opção, no sessionStorage
note right of UC09 : Somente pedidos com\nparecer positivo (APROVADO)
@enduml
